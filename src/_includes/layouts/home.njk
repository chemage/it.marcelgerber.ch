---
layout: layouts/base.njk
---
{% set posts = pagination.items %}
{% include "partials/post-list.njk" %}
{% if pagination.pages.length > 1 %}
<nav class="pagination" aria-label="Pagination">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev">← Newer</a>{% else %}<span></span>{% endif %}
  <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next }}" rel="next">Older →</a>{% else %}<span></span>{% endif %}
</nav>
{% endif %}
