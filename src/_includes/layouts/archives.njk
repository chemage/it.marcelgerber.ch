---
layout: layouts/base.njk
---
<article class="page">
  <h1 class="page-title">{{ title }}</h1>
  {%- for group in collections.postsByYear %}
  <section class="archive-year">
    <h2>{{ group.year }} <small>{{ group.posts.length }}</small></h2>
    <ul class="archive-list">
      {%- for post in group.posts %}
      <li><time datetime="{{ post.date | dateISO }}">{{ post.date | dateShort }}</time> <a href="{{ post.url }}">{{ post.data.title }}</a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endfor %}
</article>
